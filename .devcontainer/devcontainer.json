{
  "name": "kms-poc-dev",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "kms-service",
  "workspaceFolder": "/app",
  "shutdownAction": "none",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
